<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#0f3460"/>
    </linearGradient>
    <linearGradient id="hrGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1BA94C"/>
      <stop offset="100%" style="stop-color:#15803d"/>
    </linearGradient>
  </defs>
  <rect width="200" height="200" rx="20" fill="url(#bgGrad)"/>
  <g transform="translate(100,100)">
    <!-- Outer circle -->
    <circle cx="0" cy="0" r="60" fill="none" stroke="url(#hrGrad)" stroke-width="6"/>
    <!-- Inner shield shape -->
    <path d="M0-45 L35-25 L35,15 L0,40 L-35,15 L-35-25 Z" fill="url(#hrGrad)" opacity="0.9"/>
    <!-- H letter -->
    <text x="0" y="8" text-anchor="middle" font-family="Arial, sans-serif" font-weight="bold" font-size="40" fill="white">H</text>
  </g>
  <!-- Text -->
  <text x="100" y="175" text-anchor="middle" font-family="Arial, sans-serif" font-weight="bold" font-size="16" fill="white" opacity="0.9">HackerRank</text>
</svg>
